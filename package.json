{
  "name": "after-hours-games",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": { "node": ">=20.18.0" },
  "scripts": {
    "dev": "node --env-file-if-exists=.env ./node_modules/vite/bin/vite.js --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
