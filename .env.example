OPENROUTER_API_KEY="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"
OPENROUTER_MODEL=openrouter/free
PORT=4173
SESSION_RATE_LIMIT_PER_HOUR=20
