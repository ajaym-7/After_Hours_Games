# Choose ollama or openrouter.
GENERATION_PROVIDER=ollama

# Local Ollama server and model. No hosted API key is required.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma4:latest
OLLAMA_KEEP_ALIVE=15m

# Optional OpenRouter settings. Keep the key on the server; never put it in a VITE_ variable.
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_MODEL=openrouter/free
# Prioritize faster providers while keeping free-model routing on the default model.
OPENROUTER_PROVIDER_SORT=throughput
PORT=4173
SESSION_RATE_LIMIT_PER_HOUR=20
